{
  "name": "AudioStream_x86",
  "version": "1.0.0",
  "description": "Windows native audio sender for AudioStream (Electron-based, no external Chrome/Edge required)",
  "main": "build/main/main.js",
  "author": "u1w2",
  "license": "MIT",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "build:watch": "tsc --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bonjour-service": "^1.4.1",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.u1w2.audiostream.x86",
    "productName": "AudioStream Sender",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "assets/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
